# Backend Environment Configuration
ENVIRONMENT=production
PROJECT_NAME="AICTE Approval Intelligence Backend"
VERSION="0.1.0"
API_V1_STR=/api/v1

# CORS Allowed Origins
# Supports comma-separated list or JSON array string.
# In production, set to your Vercel production domain and optional local dev origins.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Supabase Auth & Storage Configuration
# Obtain from Supabase Project Settings -> API & Project Settings -> Configuration -> JWT Settings
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"

# Required for the Document Storage Cleanup Worker (kept secure on backend only)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

