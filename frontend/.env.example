# AICTE Approval Intelligence Platform - Frontend Environment Variables
NEXT_PUBLIC_APP_NAME="AICTE Approval Intelligence Platform"
NEXT_PUBLIC_APP_SHORT_NAME="AIP"
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
NEXT_PUBLIC_ENVIRONMENT=development

# Supabase Authentication Configuration (Module 2)
# Obtain from Supabase Project Settings -> API (Project URL and Publishable Key)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"
