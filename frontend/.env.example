# AICTE Approval Intelligence Platform - Frontend Environment Variables
NEXT_PUBLIC_APP_NAME="AICTE Approval Intelligence Platform"
NEXT_PUBLIC_APP_SHORT_NAME="AIP"

# Backend FastAPI Service URL (Point to your Render deployment in production)
NEXT_PUBLIC_API_BASE_URL="https://your-backend-service.onrender.com"
NEXT_PUBLIC_BACKEND_URL="https://your-backend-service.onrender.com/api"

NEXT_PUBLIC_ENABLE_DEMO_DATA=false
NEXT_PUBLIC_ENVIRONMENT=production

# Supabase Public Configuration (Module 2 & 3)
# Obtain from Supabase Project Settings -> API (Project URL and Publishable Key)
# CRITICAL: NEVER put SUPABASE_SERVICE_ROLE_KEY or database passwords here!
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"

